# Host ports published by Docker (what you open in the browser)
API_PORT=8000
WEB_PORT=3000

# Public API URL as seen by the browser (host + API_PORT)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Must match the URL where the web app is opened (host + WEB_PORT)
CORS_ORIGINS=http://localhost:3000

# Production behind an HTTPS reverse proxy (strip the /api prefix on the proxy):
#   NEXT_PUBLIC_API_URL=https://weeknotes.ru/api
#   NEXT_PUBLIC_WS_URL=wss://weeknotes.ru/api
#   CORS_ORIGINS=https://weeknotes.ru
# HTTPS is required for PWA install, geolocation and camera access.

# JWT signing secret — change in production
SECRET_KEY=change-me-to-a-long-random-string
